# Environment Variables Template for Deployment
# Copy this file to .env or set these environment variables in your deployment platform (Vercel, Render, Railway, Docker, AWS, etc.)

# Server Settings
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Connection (MongoDB Connection String)
# Local MongoDB: mongodb://localhost:27017/school_of_scholars
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/school_of_scholars?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/school_of_scholars

# Public Web Application Base URL
NEXT_PUBLIC_APP_URL=https://your-domain.com
